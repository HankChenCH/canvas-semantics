            "name": "multiple-fragments-concatenate",
            "description": "多片段拼接（根键 + 行字段）",
            "template": "{{orderNo}}-{{row.name}}",
            "context": {
                "row": {
                    "name": "张三",
                    "user": {
                        "city": "杭州"
                    },
                    "score": 98.5
                },
                "$index": 3,
                "orderNo": "A2026-001"
            },
            "expect": "A2026-001-张三"
        },
